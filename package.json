{
  "name": "herdr-nameplate",
  "version": "0.3.0",
  "description": "Herdr plugin for Windows: name each tab after where the work is and what its agent is doing.",
  "keywords": [
    "herdr",
    "herdr-plugin",
    "windows",
    "tab",
    "terminal",
    "naming",
    "pi",
    "claude",
    "codex"
  ],
  "homepage": "https://github.com/miscellaneous-repo/herdr-nameplate#readme",
  "bugs": {
    "url": "https://github.com/miscellaneous-repo/herdr-nameplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miscellaneous-repo/herdr-nameplate.git"
  },
  "license": "GPL-3.0-only",
  "author": "Athenyx",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/main.mjs",
  "exports": {
    ".": "./src/main.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "herdr-nameplate": "bin/ar.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "herdr-plugin.toml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "doctor": "node bin/ar.mjs doctor",
    "doctor:json": "node bin/ar.mjs doctor --json",
    "pass": "node bin/ar.mjs startup --verbose",
    "reset": "node bin/ar.mjs reset",
    "link": "herdr plugin link . --enabled",
    "unlink": "herdr plugin unlink herdr-nameplate",
    "status": "herdr plugin list",
    "prepublishOnly": "node --test"
  }
}
