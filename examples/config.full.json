{
  "enabled": true,
  "dryRun": false,
  "nameTabs": true,
  "tabContext": true,
  "showBranch": true,
  "agentTitles": true,
  "sessionTask": true,
  "sessionName": true,
  "sessionTailBytes": 65536,
  "maxNameLen": 20,
  "maxContextLen": 12,
  "maxBranchLen": 12,
  "maxTitleLen": 28,
  "minTaskLen": 7,
  "maxTotalLen": 60,
  "contextSep": " › ",
  "hideShell": false,
  "shellName": "pwsh",
  "shellPrograms": [
    "pwsh",
    "powershell",
    "cmd",
    "conhost",
    "openconsole",
    "bash",
    "zsh",
    "fish",
    "nu",
    "wsl"
  ],
  "ignoredPrograms": [
    "ls",
    "dir",
    "cat",
    "type",
    "echo",
    "cd",
    "pwd",
    "cls",
    "clear",
    "which",
    "where",
    "head",
    "tail",
    "wc",
    "cp",
    "mv",
    "rm",
    "del",
    "mkdir",
    "touch"
  ],
  "programAliases": {},
  "agentNameFallback": true,
  "titleIgnore": [
    "claude code",
    "codex cli",
    "gemini cli",
    "cursor agent",
    "aider",
    "chatgpt",
    "openai codex",
    "copilot",
    "qwen code"
  ],
  "defaultBranches": [
    "main",
    "master"
  ],
  "stateDir": "",
  "stateFileName": "state.json",
  "logFileName": "last-run.log",
  "logMaxBytes": 131072,
  "cacheMaxSessions": 200,
  "maxProcessLookups": 16,
  "timeoutMs": 8000,
  "herdrBin": "",
  "autoMode": "once"
}
