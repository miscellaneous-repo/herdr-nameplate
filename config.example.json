{
  "enabled": true,
  "dryRun": false,

  "nameTabs": true,
  "tabContext": true,
  "showBranch": true,
  "agentTitles": true,

  "maxNameLen": 20,
  "maxContextLen": 12,
  "maxBranchLen": 12,
  "maxTitleLen": 28,
  "minTaskLen": 7,
  "maxTotalLen": 60,
  "contextSep": " › ",

  "hideShell": false,
